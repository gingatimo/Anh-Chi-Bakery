# Supabase (tùy chọn) — bật sao lưu & đồng bộ đa thiết bị.
# Chép file này thành `.env.local` rồi điền giá trị của project bạn:
#   Supabase Dashboard → Project Settings → API
# CHỈ dùng anon/publishable key ở frontend — KHÔNG bao giờ service_role.
# Thiếu 2 biến này thì app vẫn chạy bình thường (local-first), chỉ tắt tài khoản.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
